# =============================================================================
# care-input 環境変数テンプレート（スマホ/タブレット入力アプリ）
# このファイルを .env または .env.local にコピーして値を入れてください。
# Vercel では各キーを Environment Variables に登録して再デプロイします。
#
# ★重要★ 閲覧用の facility-portal と「同じ Supabase・同じ組織ID・同じシークレット」
#         を設定してください。値が一致して初めて記録が自動連携されます。
# =============================================================================

# --- 組織・同期（facility-portal と必ず同じ値）---
# Supabase organizations.id（UUID）
VITE_CARELINK_ORGANIZATION_ID=
# 同期用共有シークレット（ブラウザにも埋め込まれます）
VITE_CARE_SYNC_SECRET=

# --- この入力アプリが記録する施設（既定の施設名 = スプレッドシートのタブ名/施設名）---
# 例: ふれあいの里
# 複数施設を切り替える場合はカンマ区切り（先頭が既定）。
VITE_CARE_INPUT_FACILITY=ふれあいの里

# --- Vercel サーバ専用（ブラウザに出さない。api/care-sync・api/staff-auth が使用）---
# Supabase プロジェクト URL
VITE_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# 同期シークレット（VITE_CARE_SYNC_SECRET と同じ値）
CARE_SYNC_SECRET=
# 職員ログインのセッション署名鍵（未設定時は CARE_SYNC_SECRET を流用）
STAFF_SESSION_SECRET=
# VITE_ 無し版（任意・サーバ側 organizationId 既定）
CARELINK_ORGANIZATION_ID=

# --- 画面右下のビルドID（任意。Vercel は自動で sha を注入）---
# VITE_APP_BUILD_ID=local
